{
  "name": "@frontfall/server",
  "version": "0.0.0",
  "private": true,
  "description": "Lobby and turn relay server.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/server.ts"
  },
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun dist/server.mjs",
    "build": "tsc -p tsconfig.json && bun build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test:bun": "bun test ./test-bun",
    "admin": "bun src/admin-main.ts"
  },
  "dependencies": {
    "@frontfall/protocol": "workspace:*",
    "nodemailer": "^10.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/nodemailer": "^8.0.2"
  }
}
