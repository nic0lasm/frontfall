{
  "name": "frontfall",
  "version": "1.0.0",
  "private": true,
  "description": "Real-time multiplayer territorial strategy game on a world without edges.",
  "license": "MIT",
  "author": "Nicolas Maigre",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=24",
    "bun": ">=1.4.4"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools",
    "e2e",
    "bench"
  ],
  "trustedDependencies": [
    "esbuild"
  ],
  "overrides": {
    "minimatch": ">=11.0.1"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "bun run --filter @frontfall/server --filter @frontfall/client dev",
    "build": "bun run --filter \"*\" build",
    "typecheck": "bun run --filter \"*\" typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:bun": "bun run --filter @frontfall/server test:bun",
    "test:e2e": "bun run --filter @frontfall/e2e test",
    "clean-room": "node tools/src/clean-room-cli.ts",
    "provenance": "node tools/src/provenance-cli.ts",
    "bench": "bun run --filter @frontfall/bench engine",
    "bench:render": "bun run --filter @frontfall/bench render",
    "perf:engine": "bun run --filter @frontfall/bench gate",
    "perf:client": "bun run --filter @frontfall/bench client",
    "maps": "bun run --filter @frontfall/tools maps",
    "announce": "bun run --filter @frontfall/tools announce",
    "playtest-report": "bun run --filter @frontfall/tools playtest-report",
    "usage:report": "bun run --filter @frontfall/tools usage:report",
    "sim": "bun run --filter @frontfall/bench sim",
    "balance": "bun run --filter @frontfall/bench balance",
    "balance:doctrines": "bun run --filter @frontfall/bench balance:doctrines",
    "campaign": "bun run --filter @frontfall/bench campaign",
    "determinism": "bun run --filter @frontfall/bench determinism",
    "golden": "bun run --filter @frontfall/bench golden",
    "load": "bun run --filter @frontfall/bench load"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{ts,js,mjs}": [
      "eslint --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": "prettier --write"
  }
}
