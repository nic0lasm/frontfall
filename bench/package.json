{
  "name": "@frontfall/bench",
  "version": "0.0.0",
  "private": true,
  "description": "Reproducible benchmarks of the simulation, the renderer and the game server.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "engine": "node --import tsx --expose-gc engine/run.ts",
    "render": "tsx render/run.ts",
    "sim": "tsx sim/run.ts",
    "balance": "tsx balance/run.ts",
    "balance:doctrines": "tsx balance/doctrines.ts",
    "load": "node --import tsx server/run.ts",
    "typecheck": "tsc -p tsconfig.json",
    "determinism": "tsx determinism/run.ts",
    "golden": "tsx determinism/golden.ts",
    "gate": "tsx gate/run.ts",
    "client": "tsx client/run.ts"
  },
  "dependencies": {
    "@frontfall/engine": "workspace:*",
    "@frontfall/protocol": "workspace:*",
    "@frontfall/server": "workspace:*",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "vite": "^8.3.5"
  }
}
